# Salin ke .env lalu isi. Jangan commit .env.
# Di Streamlit Cloud: isi lewat Settings > Secrets. Di Render: Environment Variables.

# Gemini (https://aistudio.google.com/apikey). Kosong = penjelasan memakai template.
GEMINI_API_KEY=
# Opsional, default gemini-3.5-flash-lite
# GEMINI_MODEL=

# Supabase Postgres, pakai "Session pooler" (IPv4). Kosong = riwayat tidak disimpan.
# postgresql://postgres.<project-id>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Opsional: path sertifikat CA; default certs/supabase-ca.crt
# DATABASE_SSL_CA=

# Hanya untuk deploy API ke Hugging Face Spaces (scripts/deploy_hf_space.py); token dengan akses write.
HF_TOKEN=
